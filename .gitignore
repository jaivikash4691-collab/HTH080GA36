# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js
package-lock.json.bak

# Environment variables & secrets (keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
*.local

# Production & Build outputs
dist/
dist-ssr/
build/
out/
.next/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads & Temporary runtime files
**/uploads/*
!**/uploads/README.md
!**/uploads/.gitkeep
temp/
tmp/
*.tmp

# SQLite & Local databases
*.db
*.sqlite
*.sqlite3

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov

# Cache & Linters
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# Editor & IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
