# Environment variables for Research Synthesis Assistant
# Copy this file to .env and fill in your actual values

# LLM Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3-32b:free
OPENROUTER_API_KEY=your_openrouter_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# To switch models, just change LLM_MODEL:
# LLM_MODEL=qwen/qwen3-235b-a22b:free
# LLM_MODEL=deepseek/deepseek-r1:free
# LLM_MODEL=google/gemma-3-27b-it:free
# LLM_MODEL=meta-llama/llama-4-scout:free

# Optional fallback providers (set LLM_PROVIDER accordingly)
# LLM_PROVIDER=openai
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Reranker Configuration
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=5

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_DB_URL=your_supabase_database_url_here

# File Upload Configuration
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# Pipeline Configuration
MAX_PARALLEL_PAPERS=3
VERIFICATION_ENABLED=true
MIN_CLAIM_CONFIDENCE=0.7

# Feature Flags
OCR_ENABLED=true
HYBRID_SEARCH_ENABLED=true
RERANKING_ENABLED=true
CLAIM_VERIFICATION_ENABLED=true